            "product": "Laptop",
            "quantity": "2",
            "unit_price": "1200",
            "seller": "",
            "category": "",
        }
    ]

    result = cleaner.clean(rows)

    assert result[0]["seller"] == ""


@pytest.mark.parametrize(
    "field,value",
