@asynccontextmanager
async def lifespan(app: FastAPI):
    if "pytest" in sys.modules:
        FastAPICache.init(InMemoryBackend(), prefix="bms-cache")
    else:
        redis = aioredis.from_url(settings.redis_url)
        FastAPICache.init(RedisBackend(redis), prefix="bms-cache")
    yield


