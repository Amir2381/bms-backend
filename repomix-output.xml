    stmt = select(SystemAlert).where(SystemAlert.id == alert_id)
    return db.scalars(stmt).first()


def mark_as_read(db: Session, alert: SystemAlert) -> SystemAlert:
    alert.is_read = True
    db.commit()
    db.refresh(alert)
    return alert
